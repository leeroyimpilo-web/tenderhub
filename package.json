{
  "name": "tenderhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db-init.mjs",
    "sync:etenders": "node scripts/sync-etenders.mjs",
    "sync:30d": "node scripts/sync-etenders.mjs --days=30",
    "test:ocds": "node --test tests/*.test.mjs",
    "import:official": "node scripts/import-ocds-file.mjs",
    "sync:portal": "node scripts/sync-etenders-portal.mjs",
    "test:e2e": "playwright test",
    "android:sync": "npx cap sync android"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "@playwright/test": "^1.56.1",
    "@capacitor/cli": "8.6.0"
  }
